android_app {
    name: "Xstore",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "26",
    target_sdk_version: "35",
    product_specific: true,
    privileged: false,
    optimize: { enabled: false },
}
