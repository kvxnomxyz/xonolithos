android_app {
    name: "XonolithSystemCenter",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "29",
    target_sdk_version: "35",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    optimize: { enabled: false },
}
